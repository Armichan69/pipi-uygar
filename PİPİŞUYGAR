local function GetAutoBulletSpeed()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local name = v.Name:lower()
                if name:find("speed") or name:find("velocity") or name:find("muzzle") or name:find("bullet") then
                    if v.Value > 10 then return v.Value end
                end
            end
        end
        for _, attr in ipairs({"BulletSpeed", "Speed", "MuzzleVelocity", "Velocity", "Projectilespeed"}) do
            local val = tool:GetAttribute(attr)
            if type(val) == "number" and val > 10 then return val end
        end
    end
    return 3500 
end

local function CalculateExtrapolatedPosition(targetPart)
    if not targetPart then return nil end
    local targetPosition = targetPart.Position

    if not tcExtrapolationEnabled then
        return targetPosition
    end

    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return targetPosition end

    local myVel = localRoot.AssemblyLinearVelocity or Vector3.new(0,0,0)
    local targetVel = targetPart.AssemblyLinearVelocity or Vector3.new(0,0,0)

    local autoBulletSpeed = GetAutoBulletSpeed()
    local distance = (targetPosition - Camera.CFrame.Position).Magnitude
    local timeToHit = distance / math.max(autoBulletSpeed, 1)

    local predictedPos = targetPosition + ((targetVel - myVel) * timeToHit) + Vector3.new(0, math.min(distance * 0.0015, 3), 0)
    return predictedPos
end

local function GetVehicleSeat()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if hum and hum.SeatPart and (hum.SeatPart:IsA("VehicleSeat") or hum.SeatPart:IsA("Seat")) then
        return hum.SeatPart
    end
    return nil
end

local function IsPlayerOrPlayerCar(model)
    if not model then return true end
    if model == LocalPlayer.Character then return true end
    
    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    local mySeat = GetVehicleSeat()
    local myCar = mySeat and mySeat:FindFirstAncestorWhichIsA("Model")
    
    if rootPart and model:IsA("Model") then
        pcall(function()
            local modelPos = model:GetPivot().Position
            if (modelPos - rootPart.Position).Magnitude < 35 then
                return true
            end
        end)
    end
    
    if model == myCar or (myCar and (myCar:IsAncestorOf(model) or model:IsAncestorOf(myCar))) then
        return true
    end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == model or (p.Character and p.Character:IsAncestorOf(model)) then
            return true
        end
    end
    
    return false
end

local function IsGenericTrafficCar(model)
    if not model:IsA("Model") then return false end
    if IsPlayerOrPlayerCar(model) then return false end

    local nameLower = model.Name:lower()
    local pathLower = model:GetFullName():lower()

    if nameLower:find("police") or nameLower:find("cop") or nameLower:find("law") or nameLower:find("enforcement") or nameLower:find("swat") or nameLower:find("officer") or
       pathLower:find("police") or pathLower:find("cop") or pathLower:find("law") or pathLower:find("enforcement") or pathLower:find("swat") then
        return false
    end

    if nameLower:find("traffic") or nameLower:find("npc") or nameLower:find("civilian") or nameLower:find("bot") or nameLower:find("car") or nameLower:find("vehicle") or
       pathLower:find("traffic") or pathLower:find("civilian") then
        return true
    end

    if model:FindFirstChildWhichIsA("VehicleSeat", true) or model:FindFirstChildWhichIsA("Seat", true) then
        return true
    end

    local isCarSized = false
    pcall(function()
        local size = model:GetExtentsSize()
        if size.X > 3 and size.Y > 1.5 and size.Z > 3 and size.X < 35 and size.Z < 35 then
            isCarSized = true
        end
    end)

    return isCarSized
end

