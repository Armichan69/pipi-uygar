local function createPlayerEsp(p)
    if tcPlayerEspCache[p] then return tcPlayerEspCache[p] end
    local cache = {
        Box = Drawing.new("Square"),
        HealthBarBg = Drawing.new("Square"),
        HealthBar = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        HeadDot = Drawing.new("Circle"),
        SkeletonLines = {}
    }
    cache.Box.Visible = false; cache.Box.Filled = false; cache.Box.Thickness = 1.5
    cache.HealthBarBg.Visible = false; cache.HealthBarBg.Filled = true; cache.HealthBarBg.Color = Color3.fromRGB(0,0,0)
    cache.HealthBar.Visible = false; cache.HealthBar.Filled = true
    cache.Name.Visible = false; cache.Name.Size = 13; cache.Name.Center = true; cache.Name.Outline = true; cache.Name.Color = Color3.fromRGB(255,255,255)
    cache.HeadDot.Visible = false; cache.HeadDot.Radius = 3; cache.HeadDot.Filled = true
    
    for i = 1, 15 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 1
        table.insert(cache.SkeletonLines, line)
    end
    
    tcPlayerEspCache[p] = cache
    return cache
end

