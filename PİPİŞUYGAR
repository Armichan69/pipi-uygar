local function tcIsTeamMate(p)
    if not tcTeamCheckEnabled then return false end
    if p == LocalPlayer then return true end
    if LocalPlayer.Team and p.Team then return LocalPlayer.Team == p.Team end
    return false
end

-- GELİŞTİRİLMİŞ AIMBOT HEDEF SEÇİMİ
local function tcGetClosestTarget()
    local closestTarget = nil
    local shortestDist3D = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")

    for _, p in ipairs(Players:GetPlayers()) do
        pcall(function()
            if p ~= LocalPlayer and not tcIsTeamMate(p) and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local targetPart = (tcAlwaysHeadshotEnabled and p.Character:FindFirstChild("Head")) or p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("UpperTorso")
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and targetPart and root then
                    if not tcWallCheckEnabled or tcIsPartVisible(targetPart, p.Character) then
                        local targetWorldPos = CalculateExtrapolatedPosition(targetPart)
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetWorldPos)
                        if onScreen then
                            local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                            if screenDist < tcFovRadius then
                                local dist3D = localRoot and (root.Position - localRoot.Position).Magnitude or screenDist
                                if dist3D < shortestDist3D then
                                    shortestDist3D = dist3D
                                    closestTarget = targetWorldPos
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    if tcTargetNpcsEnabled then
        pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj ~= LocalPlayer.Character then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    local targetPart = (tcAlwaysHeadshotEnabled and obj:FindFirstChild("Head")) or obj:FindFirstChild("Head") or obj:FindFirstChild("UpperTorso")
                    local root = obj:FindFirstChild("HumanoidRootPart") or targetPart
                    if hum and hum.Health > 0 and targetPart and root then
                        local isPlayer = false
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p.Character == obj then isPlayer = true break end
                        end
                        if not isPlayer then
                            if not tcWallCheckEnabled or tcIsPartVisible(targetPart, obj) then
                                local targetWorldPos = CalculateExtrapolatedPosition(targetPart)
                                local screenPos, onScreen = Camera:WorldToViewportPoint(targetWorldPos)
                                if onScreen then
                                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                                    if screenDist < tcFovRadius then
                                        local dist3D = localRoot and (root.Position - localRoot.Position).Magnitude or screenDist
                                        if dist3D < shortestDist3D then
                                            shortestDist3D = dist3D
                                            closestTarget = targetWorldPos
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    return closestTarget
end

