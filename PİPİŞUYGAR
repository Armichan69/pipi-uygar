        hmLine4.From = center + Vector2.new(size, size) hmLine4.To = center + Vector2.new(3, 3)
        
        for _, l in ipairs({hmLine1, hmLine2, hmLine3, hmLine4}) do l.Visible = true l.Color = Color3.fromRGB(255, 255, 255) end
