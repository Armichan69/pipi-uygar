-- DÜŞÜK MS & OPTİMAL SUNUCU BULUP JOIN ATMA
local function HopToLowPingServer()
    print("[ServerHopper] Düşük MS'li sunucular taranıyor...")
    pcall(function()
        local placeId = game.PlaceId
        local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
        if not req then
            local serversApi = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/0?sortOrder=Asc&limit=100"
            local rawData = game:HttpGet(serversApi)
            local data = HttpService:JSONDecode(rawData)
            if data and data.data then
                for _, s in ipairs(data.data) do
                    if s.id ~= game.JobId and s.playing < s.maxPlayers then
                        TeleportService:TeleportToPlaceInstance(placeId, s.id, LocalPlayer)
                        return
                    end
                end
            end
        else
            local serversApi = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/0?sortOrder=Asc&limit=100"
            local response = req({Url = serversApi, Method = "GET"})
            if response and response.Body then
                local data = HttpService:JSONDecode(response.Body)
                if data and data.data then
                    local bestServer = nil
                    local lowestPing = 9999
                    
                    for _, s in ipairs(data.data) do
                        if s.id ~= game.JobId and s.playing < s.maxPlayers then
                            local ping = s.ping or 999
                            if ping < lowestPing then
                                lowestPing = ping
                                bestServer = s.id
                            end
                        end
                    end
                    
                    if bestServer then
                        print("[ServerHopper] En Düşük MS Sunucu Bulundu! (" .. lowestPing .. "ms) Bağlanılıyor...")
                        TeleportService:TeleportToPlaceInstance(placeId, bestServer, LocalPlayer)
                    else
                        print("[ServerHopper] Uygun sunucu bulunamadı, rastgele hop atılıyor...")
                        TeleportService:Teleport(placeId, LocalPlayer)
                    end
                end
            end
        end
    end)
end

shActionSec:addButton("🚀 DÜŞÜK MS SUNUCUYA JOIN AT (Server Hop)", function()
