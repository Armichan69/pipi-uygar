table.insert(AllTasks, task.spawn(function()
    while scriptRunning do
        task.wait(0.1)
        pcall(function()
            local char = LocalPlayer.Character
            local tools = {}
            if char then
                for _, t in ipairs(char:GetChildren()) do if t:IsA("Tool") then table.insert(tools, t) end end
            end
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if bp then
                for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(tools, t) end end
            end

            for _, tool in ipairs(tools) do
                -- Full Auto Modifier
                if tcFullAutoEnabled then
                    if tool:FindFirstChild("Auto") and tool.Auto:IsA("BoolValue") then tool.Auto.Value = true end
                    if tool:FindFirstChild("Mode") and (tool.Mode:IsA("StringValue") or tool.Mode:IsA("IntValue")) then tool.Mode.Value = "Auto" end
                    tool:SetAttribute("Auto", true)
                    tool:SetAttribute("FireMode", "Auto")
                end

                -- Instant Reload & Infinite Ammo
                if tcInstantReloadEnabled or tcInfiniteAmmoEnabled then
                    for _, v in ipairs(tool:GetDescendants()) do
                        if v:IsA("NumberValue") or v:IsA("IntValue") then
                            local name = v.Name:lower()
                            if tcInstantReloadEnabled and (name:find("reload") or name:find("reloadtime")) then
                                v.Value = 0
                            end
                            if tcInfiniteAmmoEnabled and (name:find("ammo") or name:find("clip") or name:find("mag")) then
                                v.Value = 999
                            end
                        end
                    end
                end

                -- Bullet Range & Velocity Boost
                if tcBulletRangeBoostEnabled then
                    for _, v in ipairs(tool:GetDescendants()) do
                        if v:IsA("NumberValue") or v:IsA("IntValue") then
                            local name = v.Name:lower()
                            if name:find("range") or name:find("dist") or name:find("speed") or name:find("velocity") then
                                v.Value = 99999
                            end
                        end
                    end
                    tool:SetAttribute("BulletSpeed", 10000)
                    tool:SetAttribute("MaxDistance", 99999)
                end

                -- No Spread & No Recoil Deep Mod
                if tcNoSpreadEnabled or tcNoRecoilEnabled then
                    for _, v in ipairs(tool:GetDescendants()) do
                        if v:IsA("NumberValue") or v:IsA("IntValue") then
                            local name = v.Name:lower()
                            if tcNoSpreadEnabled and (name:find("spread") or name:find("accuracy") or name:find("inaccuracy")) then
                                v.Value = 0
                            end
                            if tcNoRecoilEnabled and (name:find("recoil") or name:find("kick")) then
                                v.Value = 0
                            end
                        end
                    end
                end
            end
        end)
    end
end))

