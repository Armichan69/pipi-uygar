table.insert(AllConnections, RunService.Heartbeat:Connect(function(deltaTime)
    pcall(function()
        local mySeat = GetVehicleSeat()
        local myVehicle = mySeat and mySeat:FindFirstAncestorWhichIsA("Model")
        
        if flightEnabled and myVehicle then
            local char = LocalPlayer.Character
            if not defaultCharacterParent and char.Parent then defaultCharacterParent = char.Parent end
            if scriptRunning then char.Parent = myVehicle end
        end

        if not scriptRunning then return end
        if not velocityEnabled or not mySeat then return end
        
        if myVehicle and ghostModeEnabled then
            for _, part in ipairs(myVehicle:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
        end

        if flightEnabled and myVehicle then
            if not myVehicle.PrimaryPart then myVehicle.PrimaryPart = (mySeat.Parent == myVehicle) and mySeat or myVehicle:FindFirstChildWhichIsA("BasePart") end
            local camLook = workspace.CurrentCamera.CFrame.LookVector
            local moveX = (UserInputService:IsKeyDown(Enum.KeyCode.D) and flightSpeed) or (UserInputService:IsKeyDown(Enum.KeyCode.A) and -flightSpeed) or 0
            local moveY = (UserInputService:IsKeyDown(Enum.KeyCode.E) and flightSpeed/2) or (UserInputService:IsKeyDown(Enum.KeyCode.Q) and -flightSpeed/2) or 0
            local moveZ = (UserInputService:IsKeyDown(Enum.KeyCode.S) and flightSpeed) or (UserInputService:IsKeyDown(Enum.KeyCode.W) and -flightSpeed) or 0
            local moveFrame = UserInputService:GetFocusedTextBox() and CFrame.new(0,0,0) or CFrame.new(moveX, moveY, moveZ)
            myVehicle:SetPrimaryPartCFrame(CFrame.new(myVehicle:GetPrimaryPartCFrame().Position, myVehicle:GetPrimaryPartCFrame().Position + camLook) * moveFrame)
            mySeat.AssemblyLinearVelocity = Vector3.new(0,0,0); mySeat.AssemblyAngularVelocity = Vector3.new(0,0,0)
            return
        end

        if defaultCharacterParent and LocalPlayer.Character then LocalPlayer.Character.Parent = defaultCharacterParent end
        local currentVel = mySeat.AssemblyLinearVelocity
        local forwardDir = mySeat.CFrame.LookVector
        local speedInForwardDir = currentVel:Dot(forwardDir)

        if UserInputService:IsKeyDown(Enum.KeyCode.W) and not UserInputService:GetFocusedTextBox() then
            if speedInForwardDir < topSpeed then mySeat.AssemblyLinearVelocity = currentVel + (forwardDir * (accelPower * deltaTime)) end
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) and not UserInputService:GetFocusedTextBox() then
            local localVal = mySeat.CFrame:VectorToObjectSpace(currentVel)
            localVal = Vector3.new(localVal.X * (1 - brakePower), localVal.Y, localVal.Z * (1 - brakePower))
            mySeat.AssemblyLinearVelocity = mySeat.CFrame:VectorToWorldSpace(localVal)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.P) and not UserInputService:GetFocusedTextBox() then
            mySeat.AssemblyLinearVelocity = Vector3.new(0,0,0); mySeat.AssemblyAngularVelocity = Vector3.new(0,0,0)
        end
    end)
end))

