local function triggerHitmarker()
    if not c2HitmarkerEnabled then return end
    task.spawn(function()
        local center = Camera.ViewportSize / 2
        local size = 8
        hmLine1.From = center - Vector2.new(size, size) hmLine1.To = center - Vector2.new(3, 3)
        hmLine2.From = center + Vector2.new(size, -size) hmLine2.To = center + Vector2.new(3, -3)
